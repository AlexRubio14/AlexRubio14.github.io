# `npm run dev` uses the deployed Worker too (it allows http://localhost:5173).
# To test a local Worker instead (wrangler dev in workers/contact), create .env.development.local with:
#   VITE_CONTACT_ENDPOINT=http://localhost:8787/contact
VITE_CONTACT_ENDPOINT=https://portfolio-contact.alexrubio14.workers.dev/contact

# Turnstile site key (public). Empty = captcha disabled. The widget must allow "localhost".
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAGLCUt5fs4AsVvZK
