# Contact form backend (Cloudflare Worker in workers/contact).
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
VITE_CONTACT_ENDPOINT=https://portfolio-contact.<your-subdomain>.workers.dev/contact

# Cloudflare Turnstile site key (public). Test key that always passes: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
